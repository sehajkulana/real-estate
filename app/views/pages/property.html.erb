<section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
    <div class="glass-card rounded-3xl overflow-hidden">
      <% if @property.property_images.first&.image&.attached? %>
        <%= image_tag @property.property_images.first.image, class: "h-[420px] w-full object-cover" %>
      <% else %>
        <div class="h-[420px] w-full bg-gradient-to-br from-gold-500/20 to-obsidian-900"></div>
      <% end %>
    </div>
    <div>
      <span class="text-gold-500 font-semibold tracking-[0.25em] text-xs uppercase block mb-3"><%= @property.property_type %></span>
      <h1 class="font-serif text-4xl md:text-5xl text-white font-bold leading-tight"><%= @property.title %></h1>
      <p class="text-gray-400 mt-6 text-lg leading-relaxed"><%= @property.description %></p>
      <div class="mt-8 grid grid-cols-2 gap-4 text-sm text-gray-300">
        <div class="glass-card rounded-2xl p-4"><strong class="text-white">Price:</strong> $<%= number_with_delimiter(@property.price.to_i) %></div>
        <div class="glass-card rounded-2xl p-4"><strong class="text-white">City:</strong> <%= @property.city %></div>
        <div class="glass-card rounded-2xl p-4"><strong class="text-white">Bedrooms:</strong> <%= @property.bedrooms %></div>
        <div class="glass-card rounded-2xl p-4"><strong class="text-white">Bathrooms:</strong> <%= @property.bathrooms %></div>
      </div>
      <%= link_to "Request Private Tour", contact_path, class: "inline-flex mt-8 bg-gold-500 hover:bg-gold-600 text-obsidian-950 font-semibold uppercase text-xs py-3 px-6 rounded-full transition-all" %>
    </div>
  </div>
</section>
