<% content_for :title, "Uptown - Agent" %>

<nav class="navbar navbar-expand-lg navbar-dark ftco_navbar bg-dark ftco-navbar-light" id="ftco-navbar">
  <div class="container">
    <a class="navbar-brand" href="<%= root_path %>">Uptown</a>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#ftco-nav" aria-controls="ftco-nav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="oi oi-menu"></span> Menu
    </button>

    <div class="collapse navbar-collapse" id="ftco-nav">
      <ul class="navbar-nav ml-auto">
        <li class="nav-item"><a href="<%= root_path %>" class="nav-link">Home</a></li>
        <li class="nav-item"><a href="<%= about_path %>" class="nav-link">About</a></li>
        <li class="nav-item active"><a href="<%= agent_path %>" class="nav-link">Agent</a></li>
        <li class="nav-item"><a href="<%= services_path %>" class="nav-link">Services</a></li>
        <li class="nav-item"><a href="<%= properties_path %>" class="nav-link">Properties</a></li>
        <li class="nav-item"><a href="<%= blog_path %>" class="nav-link">Blog</a></li>
        <li class="nav-item"><a href="<%= contact_path %>" class="nav-link">Contact</a></li>
      </ul>
    </div>
  </div>
</nav>

<section class="hero-wrap hero-wrap-2 ftco-degree-bg js-fullheight" style="background-image: url('/uptown/images/bg_1.jpg');" data-stellar-background-ratio="0.5">
  <div class="overlay"></div>
  <div class="container">
    <div class="row no-gutters slider-text js-fullheight align-items-center justify-content-center">
      <div class="col-md-9 ftco-animate pb-5 text-center">
        <p class="breadcrumbs"><span class="mr-2"><a href="<%= root_path %>">Home <i class="ion-ios-arrow-forward"></i></a></span> <span>Agent <i class="ion-ios-arrow-forward"></i></span></p>
        <h1 class="mb-3 bread">Agent</h1>
      </div>
    </div>
  </div>
</section>

<section class="ftco-section ftco-agent">
  <div class="container">
    <div class="row">
      <% [{name: "James Stallon", image: "team-1.jpg"}, {name: "James Stallon", image: "team-2.jpg"}, {name: "James Stallon", image: "team-3.jpg"}, {name: "James Stallon", image: "team-4.jpg"}, {name: "James Stallon", image: "team-5.jpg"}, {name: "James Stallon", image: "team-6.jpg"}, {name: "James Stallon", image: "team-7.jpg"}, {name: "James Stallon", image: "team-8.jpg"}].each do |agent| %>
        <div class="col-md-3">
          <div class="agent">
            <div class="img">
              <img src="/uptown/images/<%= agent[:image] %>" class="img-fluid" alt="Colorlib Template">
            </div>
            <div class="desc">
              <h3><a href="<%= properties_path %>"><%= agent[:name] %></a></h3>
              <p class="h-info"><span class="location">Listing</span> <span class="details">&mdash; 10 Properties</span></p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

