    </div>
    <div class="row">
      <div class="col-md-12 text-center">
        <p>Copyright &copy;<%= Time.current.year %> All rights reserved | This template is made with <i class="icon-heart color-danger" aria-hidden="true"></i> by <a href="https://colorlib.com" target="_blank">Colorlib</a></p>
      </div>
    </div>
  </div>
</footer>
