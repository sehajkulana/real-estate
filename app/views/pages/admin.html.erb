<section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="mb-10">
    <span class="text-gold-500 font-semibold tracking-[0.25em] text-xs uppercase block mb-3">Admin Panel</span>
    <h1 class="font-serif text-4xl md:text-5xl text-white font-bold leading-tight">Create a New Property</h1>
    <p class="text-gray-400 mt-4 max-w-2xl">Use this page to add a fresh listing to the premium portfolio.</p>
  </div>

  <% if flash[:notice] %>
    <div class="mb-6 rounded-2xl border border-green-500/30 bg-green-500/10 px-4 py-3 text-green-300">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <% if flash[:alert] %>
    <div class="mb-6 rounded-2xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-red-300">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <div class="glass-card rounded-3xl p-8">
    <%= form_with model: @property, url: create_property_path, local: true, class: "space-y-6" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm text-gray-300 mb-2">Title</label>
          <%= f.text_field :title, class: "w-full rounded-2xl border border-white/10 bg-obsidian-950/70 px-4 py-3 text-white" %>
        </div>
        <div>
          <label class="block text-sm text-gray-300 mb-2">Seller</label>
          <%= f.collection_select :seller_id, @sellers, :id, ->(user) { "#{user.first_name} #{user.last_name}" }, { include_blank: true }, class: "w-full rounded-2xl border border-white/10 bg-obsidian-950/70 px-4 py-3 text-white" %>
        </div>
        <div>
          <label class="block text-sm text-gray-300 mb-2">Listing Type</label>
          <%= f.select :listing_type, options_for_select([['Sale', 'Sale'], ['Rent', 'Rent']], @property.listing_type), { include_blank: true }, class: "w-full rounded-2xl border border-white/10 bg-obsidian-950/70 px-4 py-3 text-white" %>
        </div>
        <div>
          <label class="block text-sm text-gray-300 mb-2">Property Type</label>
          <%= f.select :property_type, options_for_select([['Residential', 'Residential'], ['Commercial', 'Commercial']], @property.property_type), { include_blank: true }, class: "w-full rounded-2xl border border-white/10 bg-obsidian-950/70 px-4 py-3 text-white" %>
        </div>
        <div>
          <label class="block text-sm text-gray-300 mb-2">Price</label>
          <%= f.number_field :price, class: "w-full rounded-2xl border border-white/10 bg-obsidian-950/70 px-4 py-3 text-white" %>
        </div>
        <div>
          <label class="block text-sm text-gray-300 mb-2">Area</label>
          <%= f.number_field :area, class: "w-full rounded-2xl border border-white/10 bg-obsidian-950/70 px-4 py-3 text-white" %>
        </div>
        <div>
          <label class="block text-sm text-gray-300 mb-2">Bedrooms</label>
          <%= f.number_field :bedrooms, class: "w-full rounded-2xl border border-white/10 bg-obsidian-950/70 px-4 py-3 text-white" %>
        </div>
        <div>
          <label class="block text-sm text-gray-300 mb-2">Bathrooms</label>
          <%= f.number_field :bathrooms, class: "w-full rounded-2xl border border-white/10 bg-obsidian-950/70 px-4 py-3 text-white" %>
        </div>
        <div>
          <label class="block text-sm text-gray-300 mb-2">City</label>
          <%= f.text_field :city, class: "w-full rounded-2xl border border-white/10 bg-obsidian-950/70 px-4 py-3 text-white" %>
        </div>
        <div>
          <label class="block text-sm text-gray-300 mb-2">State</label>
          <%= f.text_field :state, class: "w-full rounded-2xl border border-white/10 bg-obsidian-950/70 px-4 py-3 text-white" %>
        </div>
        <div>
          <label class="block text-sm text-gray-300 mb-2">Country</label>
          <%= f.text_field :country, class: "w-full rounded-2xl border border-white/10 bg-obsidian-950/70 px-4 py-3 text-white" %>
        </div>
        <div>
          <label class="block text-sm text-gray-300 mb-2">Address</label>
          <%= f.text_field :address, class: "w-full rounded-2xl border border-white/10 bg-obsidian-950/70 px-4 py-3 text-white" %>
        </div>
      </div>

      <div>
        <label class="block text-sm text-gray-300 mb-2">Description</label>
        <%= f.text_area :description, rows: 5, class: "w-full rounded-2xl border border-white/10 bg-obsidian-950/70 px-4 py-3 text-white" %>
      </div>

      <div>
        <label class="block text-sm text-gray-300 mb-2">Images</label>
        <%= file_field_tag "property[images][]", multiple: true, class: "w-full rounded-2xl border border-white/10 bg-obsidian-950/70 px-4 py-3 text-white" %>
      </div>

      <div class="flex items-center gap-4">
        <%= f.submit "Create Property", class: "bg-gold-500 hover:bg-gold-600 text-obsidian-950 font-semibold uppercase text-xs py-3 px-6 rounded-full transition-all" %>
        <%= link_to "View Listings", properties_path, class: "text-gold-400 hover:text-gold-300 text-sm" %>
      </div>
    <% end %>
  </div>
</section>
