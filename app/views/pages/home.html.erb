<section id="view-home" class="page-view animate-section active">
  <div class="relative min-h-[85vh] flex items-center justify-center overflow-hidden bg-black py-16">
    <div class="absolute inset-0 z-0">
      <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1920&q=80" alt="Luxury penthouse" class="w-full h-full object-cover opacity-35 object-center scale-110">
      <div class="absolute inset-0 bg-gradient-to-t from-obsidian-950 via-obsidian-950/60 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-obsidian-950/80 via-transparent to-obsidian-950/80"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mt-8">
      <div class="inline-flex items-center space-x-2 bg-gold-500/10 border border-gold-500/30 px-4 py-1.5 rounded-full mb-6">
        <span class="w-1.5 h-1.5 bg-gold-500 rounded-full animate-ping"></span>
        <span class="text-[10px] md:text-xs tracking-[0.25em] text-gold-300 uppercase font-medium">Bespoke Real Estate Advisory</span>
      </div>

      <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl text-white font-bold tracking-tight leading-none mb-6 max-w-5xl mx-auto">
        Architectural Wonders <br><span class="italic text-gold-400 font-normal">Made Manifest</span>
      </h1>

      <p class="text-gray-300 text-sm md:text-lg lg:text-xl max-w-2xl mx-auto tracking-wide font-light mb-12">
        Discover DUA’s curated collection of handpicked luxuries, estates, and high-growth commercial developments.
      </p>

      <div class="max-w-4xl mx-auto glass-card p-4 rounded-2xl md:rounded-full border border-white/10 shadow-2xl">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-center">
          <div class="px-4 text-left border-b md:border-b-0 md:border-r border-white/10 pb-3 md:pb-0">
            <label class="block text-[10px] text-gold-400 font-semibold uppercase tracking-widest mb-1">Property Type</label>
            <select class="bg-transparent text-white w-full focus:outline-none text-sm font-medium cursor-pointer">
              <option value="all" class="bg-obsidian-900">All Asset Classes</option>
              <option value="Residential" class="bg-obsidian-900">Residential Estates</option>
              <option value="Commercial" class="bg-obsidian-900">Commercial Hubs</option>
            </select>
          </div>

          <div class="px-4 text-left border-b md:border-b-0 md:border-r border-white/10 pb-3 md:pb-0">
            <label class="block text-[10px] text-gold-400 font-semibold uppercase tracking-widest mb-1">Max Budget</label>
            <select class="bg-transparent text-white w-full focus:outline-none text-sm font-medium cursor-pointer">
              <option value="99999999" class="bg-obsidian-900">No Limit</option>
              <option value="1500000" class="bg-obsidian-900">Under $1.5M</option>
              <option value="3000000" class="bg-obsidian-900">Under $3.0M</option>
            </select>
          </div>

          <div class="px-4 text-left pb-3 md:pb-0 md:border-r border-white/10">
            <label class="block text-[10px] text-gold-400 font-semibold uppercase tracking-widest mb-1">Minimum Area</label>
            <select class="bg-transparent text-white w-full focus:outline-none text-sm font-medium cursor-pointer">
              <option value="0" class="bg-obsidian-900">Any Size</option>
              <option value="1500" class="bg-obsidian-900">1,500+ sq ft</option>
              <option value="3000" class="bg-obsidian-900">3,000+ sq ft</option>
            </select>
          </div>

          <div class="px-2">
            <%= link_to properties_path, class: "w-full bg-gold-500 hover:bg-gold-600 text-obsidian-950 font-bold uppercase text-xs py-3.5 px-6 rounded-full transition-all duration-300 flex items-center justify-center space-x-2" do %>
              <i class="fa-solid fa-magnifying-glass"></i>
              <span>Explore Collection</span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-obsidian-900/40 py-12 border-y border-gold-500/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div class="p-4 border-r border-white/5 last:border-0">
          <span class="block font-serif text-3xl md:text-5xl text-gold-500 font-bold tracking-tight mb-2">$1.8B+</span>
          <span class="text-[11px] md:text-xs tracking-[0.2em] text-gray-400 uppercase">Premium Sales Volume</span>
        </div>
        <div class="p-4 border-r border-white/5 last:border-0">
          <span class="block font-serif text-3xl md:text-5xl text-gold-500 font-bold tracking-tight mb-2">450+</span>
          <span class="text-[11px] md:text-xs tracking-[0.2em] text-gray-400 uppercase">Curated Handpicked Assets</span>
        </div>
        <div class="p-4 border-r border-white/5 last:border-0">
          <span class="block font-serif text-3xl md:text-5xl text-gold-500 font-bold tracking-tight mb-2">98.4%</span>
          <span class="text-[11px] md:text-xs tracking-[0.2em] text-gray-400 uppercase">VIP Client Retention</span>
        </div>
        <div class="p-4 last:border-0">
          <span class="block font-serif text-3xl md:text-5xl text-gold-500 font-bold tracking-tight mb-2">40+</span>
          <span class="text-[11px] md:text-xs tracking-[0.2em] text-gray-400 uppercase">Years of Advisory Experience</span>
        </div>
      </div>
    </div>
  </div>

  <div class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16">
      <div>
        <span class="text-gold-500 font-semibold tracking-[0.25em] text-xs uppercase block mb-3">Dua Premier Signature Collection</span>
        <h2 class="font-serif text-4xl md:text-6xl text-white font-bold leading-none tracking-tight">Epitome of Architectural Glory</h2>
      </div>
      <div class="mt-6 md:mt-0 flex items-center space-x-4">
        <%= link_to properties_path, class: "group text-gold-400 hover:text-gold-500 text-sm tracking-widest font-semibold uppercase flex items-center space-x-2 transition-all" do %>
          <span>Browse All Real Estate</span>
          <i class="fa-solid fa-arrow-right transition-transform group-hover:translate-x-1"></i>
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <% @featured_properties.each do |property| %>
        <div class="tilt-wrapper">
          <article class="glass-card cursor-pointer overflow-hidden rounded-3xl shadow-xl flex flex-col group h-full" data-property-modal-trigger="true" data-title="<%= j(property.title) %>" data-description="<%= j(property.description.to_s) %>" data-price="<%= property.price.to_i %>" data-city="<%= j(property.city.to_s) %>" data-address="<%= j(property.address.to_s) %>" data-property-type="<%= j(property.property_type.to_s) %>" data-bedrooms="<%= property.bedrooms %>" data-bathrooms="<%= property.bathrooms %>" data-area="<%= property.area %>" data-image-url="<%= property.property_images.first&.image&.attached? ? url_for(property.property_images.first.image) : '' %>"
               onmousemove="handleCardTilt(event, this)"
               onmouseleave="resetCardTilt(this)">
            <div class="relative h-64 overflow-hidden bg-black">
              <% if property.property_images.first&.image&.attached? %>
                <%= image_tag property.property_images.first.image, class: "h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" %>
              <% else %>
                <div class="h-full w-full bg-gradient-to-br from-gold-500/20 to-obsidian-900"></div>
              <% end %>
              <div class="absolute inset-0 bg-gradient-to-t from-obsidian-950 via-transparent"></div>
              <div class="absolute bottom-4 left-4 flex items-center gap-2">
                <span class="bg-obsidian-950/90 border border-gold-500/40 text-gold-400 font-bold tracking-widest text-[9px] uppercase px-3 py-1 rounded-full"><%= property.listing_type %></span>
                <span class="bg-gold-500 text-obsidian-950 font-bold tracking-widest text-[9px] uppercase px-3 py-1 rounded-full"><%= property.property_type %></span>
              </div>
            </div>
            <div class="p-7 flex-grow flex flex-col justify-between space-y-4">
              <div>
                <p class="text-gold-400 text-[10px] tracking-widest uppercase font-medium mb-1"><i class="fa-solid fa-location-dot mr-1"></i> <%= [property.city, property.country].compact_blank.join(', ') %></p>
                <h3 class="font-serif text-2xl text-white mb-3 group-hover:text-gold-400 transition-colors"><%= property.title %></h3>
                <p class="text-gray-400 text-sm leading-relaxed"><%= truncate(property.description, length: 120) %></p>
              </div>
              <div class="grid grid-cols-3 gap-2 border-t border-white/5 pt-4 text-center">
                <div>
                  <span class="block text-[8px] tracking-widest text-gray-500 uppercase">Est. Area</span>
                  <span class="text-xs text-white font-medium"><%= number_with_delimiter(property.area) %> <%= property.area_unit.presence || 'sq ft' %></span>
                </div>
                <div class="border-x border-white/5">
                  <span class="block text-[8px] tracking-widest text-gray-500 uppercase">Configuration</span>
                  <span class="text-xs text-white font-medium"><%= property.bedrooms %> Bed</span>
                </div>
                <div>
                  <span class="block text-[8px] tracking-widest text-gray-500 uppercase">Bathrooms</span>
                  <span class="text-xs text-white font-medium"><%= property.bathrooms %> Bath</span>
                </div>
              </div>
              <div class="flex items-center justify-between border-t border-white/5 pt-4">
                <div>
                  <span class="text-[9px] text-gray-500 uppercase tracking-widest block"><%= property.listing_type %></span>
                  <p class="text-gold-400 text-lg font-serif font-semibold">$<%= number_with_delimiter(property.price.to_i) %></p>
                </div>
                <button type="button" class="text-xs text-gold-400 uppercase tracking-widest font-bold group-hover:translate-x-1.5 transition-transform flex items-center space-x-1">
                  <span>View Details</span>
                  <i class="fa-solid fa-chevron-right text-[10px]"></i>
                </button>
              </div>
            </div>
          </article>
        </div>
      <% end %>
    </div>
  </div>

  <div class="bg-obsidian-900 border-y border-gold-500/10 py-24 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-gold-500/30 rounded-full filter blur-[100px]"></div>
      <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-gold-500/30 rounded-full filter blur-[100px]"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5 text-left">
          <span class="text-gold-500 font-semibold tracking-[0.25em] text-xs uppercase block mb-3">Finance Management Advisory</span>
          <h2 class="font-serif text-4xl md:text-5xl text-white font-bold leading-tight mb-6">Interactive Investment Calculator</h2>
          <p class="text-gray-300 text-sm md:text-base leading-relaxed mb-8">Acquire premium properties and instantly estimate loans with clarity and precision.</p>
          <div class="space-y-4">
            <div class="flex items-start space-x-3">
              <div class="mt-1 flex-shrink-0 text-gold-500"><i class="fa-solid fa-circle-check"></i></div>
              <p class="text-gray-400 text-sm">Flexible down payment configuration.</p>
            </div>
            <div class="flex items-start space-x-3">
              <div class="mt-1 flex-shrink-0 text-gold-500"><i class="fa-solid fa-circle-check"></i></div>
              <p class="text-gray-400 text-sm">Instant monthly repayment insights.</p>
            </div>
            <div class="flex items-start space-x-3">
              <div class="mt-1 flex-shrink-0 text-gold-500"><i class="fa-solid fa-circle-check"></i></div>
              <p class="text-gray-400 text-sm">Clear principal and interest summaries.</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <div class="glass-card p-8 md:p-10 rounded-2xl border border-white/10 shadow-2xl">
            <h3 class="text-white font-semibold text-lg uppercase tracking-wider mb-8 flex items-center space-x-3">
              <i class="fa-solid fa-calculator text-gold-500"></i>
              <span>Plan Your Wealth Allocation</span>
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
              <div class="space-y-6">
                <div>
                  <div class="flex justify-between text-xs tracking-wider uppercase text-gray-400 mb-2">
                    <span>Property Value</span>
                    <span class="text-gold-400 font-semibold" id="standalone-calc-val-label">$3,500,000</span>
                  </div>
                  <input type="range" id="standalone-calc-val" min="500000" max="25000000" step="100000" value="3500000" class="w-full h-1 bg-gray-800 rounded-lg appearance-none cursor-pointer accent-gold-500">
                  <div class="flex justify-between text-[10px] text-gray-600 mt-1">
                    <span>$500K</span>
                    <span>$25M</span>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between text-xs tracking-wider uppercase text-gray-400 mb-2">
                    <span>Down Payment (20%)</span>
                    <span class="text-gold-400 font-semibold" id="standalone-calc-down-label">$700,000</span>
                  </div>
                  <input type="range" id="standalone-calc-down" min="10" max="80" step="5" value="20" class="w-full h-1 bg-gray-800 rounded-lg appearance-none cursor-pointer accent-gold-500">
                  <div class="flex justify-between text-[10px] text-gray-600 mt-1">
                    <span>10%</span>
                    <span>80%</span>
                  </div>
                </div>
              </div>

              <div class="space-y-6">
                <div>
                  <div class="flex justify-between text-xs tracking-wider uppercase text-gray-400 mb-2">
                    <span>Annual Interest Rate</span>
                    <span class="text-gold-400 font-semibold" id="standalone-calc-rate-label">5.5%</span>
                  </div>
                  <input type="range" id="standalone-calc-rate" min="2.0" max="12.0" step="0.1" value="5.5" class="w-full h-1 bg-gray-800 rounded-lg appearance-none cursor-pointer accent-gold-500">
                  <div class="flex justify-between text-[10px] text-gray-600 mt-1">
                    <span>2%</span>
                    <span>12%</span>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between text-xs tracking-wider uppercase text-gray-400 mb-2">
                    <span>Amortization Term</span>
                    <span class="text-gold-400 font-semibold" id="standalone-calc-term-label">30 Years</span>
                  </div>
                  <input type="range" id="standalone-calc-term" min="5" max="30" step="5" value="30" class="w-full h-1 bg-gray-800 rounded-lg appearance-none cursor-pointer accent-gold-500">
                  <div class="flex justify-between text-[10px] text-gray-600 mt-1">
                    <span>5 Years</span>
                    <span>30 Years</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="bg-obsidian-950/60 border border-white/5 rounded-xl p-6 grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
              <div class="border-b md:border-b-0 md:border-r border-white/5 pb-4 md:pb-0">
                <span class="block text-[10px] tracking-widest text-gray-400 uppercase mb-1">Mortgage Amount</span>
                <span class="text-lg text-white font-medium" id="standalone-val-financed">$2,800,000</span>
              </div>
              <div class="border-b md:border-b-0 md:border-r border-white/5 pb-4 md:pb-0">
                <span class="block text-[10px] tracking-widest text-gray-400 uppercase mb-1">Total Interest Paid</span>
                <span class="text-lg text-white font-medium" id="standalone-val-interest">$2,927,330</span>
              </div>
              <div>
                <span class="block text-[10px] tracking-widest text-gold-400 font-medium uppercase mb-1">Monthly Payment</span>
                <span class="text-2xl text-gold-500 font-bold gold-glow" id="standalone-val-monthly">$15,898/mo</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <span class="text-gold-500 font-semibold tracking-[0.25em] text-xs uppercase block mb-3">Advisory Team</span>
        <h2 class="font-serif text-4xl md:text-5xl text-white font-bold leading-tight">Meet the Experts</h2>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <% @agents.each do |agent| %>
        <div class="glass-card rounded-3xl p-7 text-center">
          <div class="w-20 h-20 rounded-full bg-gradient-to-br from-gold-500/40 to-obsidian-900 mx-auto mb-5 flex items-center justify-center text-2xl text-gold-400">
            <i class="fa-solid fa-user-tie"></i>
          </div>
          <h3 class="font-serif text-2xl text-white mb-2"><%= agent.first_name %> <%= agent.last_name %></h3>
          <p class="text-gold-400 text-sm uppercase tracking-[0.2em] mb-4">Real Estate Advisor</p>
          <p class="text-gray-400 text-sm leading-relaxed">Specializing in premium placements, investment strategy, and bespoke acquisitions.</p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<script>
  function formatCurrency(value) {
    return new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(value);
  }

  function calculateLoan() {
    const propertyValue = Number(document.getElementById("standalone-calc-val")?.value || 0);
    const downPercent = Number(document.getElementById("standalone-calc-down")?.value || 0) / 100;
    const annualRate = Number(document.getElementById("standalone-calc-rate")?.value || 0) / 100;
    const years = Number(document.getElementById("standalone-calc-term")?.value || 0);
    const downPayment = propertyValue * downPercent;
    const loanAmount = propertyValue - downPayment;
    const monthlyRate = annualRate / 12;
    const months = years * 12;
    const payment = monthlyRate > 0 ? (loanAmount * monthlyRate) / (1 - Math.pow(1 + monthlyRate, -months)) : loanAmount / months;
    const totalPaid = payment * months;
    const totalInterest = totalPaid - loanAmount;

    document.getElementById("standalone-calc-val-label").textContent = formatCurrency(propertyValue);
    document.getElementById("standalone-calc-down-label").textContent = `${formatCurrency(downPayment)} (${downPercent * 100}%)`;
    document.getElementById("standalone-calc-rate-label").textContent = `${annualRate * 100}%`;
    document.getElementById("standalone-calc-term-label").textContent = `${years} Years`;
    document.getElementById("standalone-val-financed").textContent = formatCurrency(loanAmount);
    document.getElementById("standalone-val-interest").textContent = formatCurrency(totalInterest);
    document.getElementById("standalone-val-monthly").textContent = `${formatCurrency(payment)}/mo`;
  }

  function initializeStandaloneCalculator() {
    ["standalone-calc-val", "standalone-calc-down", "standalone-calc-rate", "standalone-calc-term"].forEach(function (id) {
      const element = document.getElementById(id);
      if (element && element.dataset.calculatorListener !== "true") {
        element.addEventListener("input", calculateLoan);
        element.dataset.calculatorListener = "true";
      }
    });
    calculateLoan();
  }

  document.addEventListener("turbo:load", initializeStandaloneCalculator);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeStandaloneCalculator);
  } else {
    initializeStandaloneCalculator();
  }
</script>
