<section id="view-home" class="page-view animate-section active">
  <div class="relative min-h-[85vh] flex items-center justify-center overflow-hidden bg-black py-16">
    <div class="absolute inset-0 z-0">
      <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1920&q=80" alt="Luxury penthouse" class="w-full h-full object-cover opacity-35 object-center scale-110">
      <div class="absolute inset-0 bg-gradient-to-t from-obsidian-950 via-obsidian-950/60 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-obsidian-950/80 via-transparent to-obsidian-950/80"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mt-8">
      <div class="inline-flex items-center space-x-2 bg-gold-500/10 border border-gold-500/30 px-4 py-1.5 rounded-full mb-6">
        <span class="w-1.5 h-1.5 bg-gold-500 rounded-full animate-ping"></span>
        <span class="text-[10px] md:text-xs tracking-[0.25em] text-gold-300 uppercase font-medium">PREMIUM REAL ESTATE</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-white font-bold tracking-tight leading-tight mb-5 max-w-4xl mx-auto">
        Find Exceptional <span class="italic text-gold-400 font-normal">Properties</span>
      </h1>

      <p class="text-gray-300 text-sm md:text-base lg:text-lg max-w-xl mx-auto tracking-wide font-light mb-10">
        Explore luxury homes, villas, and commercial spaces tailored for you.
      </p>      <div class="max-w-4xl mx-auto glass-card p-6 md:p-8 rounded-3xl border border-white/10 shadow-2xl text-left">
        <%# ===== Buy / Rent / All Tabs ===== %>
        <div class="flex gap-2 mb-5">
          <a href="<%= root_path(@filters.except('listing_type', 'filter').merge(listing_type: 'Sale')) %>"
             class="px-5 py-2 rounded-full text-xs font-bold uppercase tracking-widest transition-all border
                    <%= (@filters['listing_type'].to_s.downcase.include?('sale') && @filters['filter'] != 'all') ? 'bg-gold-500 text-obsidian-950 border-gold-500' : 'border-white/10 text-gray-300 hover:border-gold-500/50 hover:text-gold-400' %>">
            Buy
          </a>
          <a href="<%= root_path(@filters.except('listing_type', 'filter').merge(listing_type: 'Rent')) %>"
             class="px-5 py-2 rounded-full text-xs font-bold uppercase tracking-widest transition-all border
                    <%= (@filters['listing_type'].to_s.downcase.include?('rent') && @filters['filter'] != 'all') ? 'bg-gold-500 text-obsidian-950 border-gold-500' : 'border-white/10 text-gray-300 hover:border-gold-500/50 hover:text-gold-400' %>">
            Rent
          </a>
          <a href="<%= root_path(@filters.except('listing_type').merge(filter: 'all')) %>"
             class="px-5 py-2 rounded-full text-xs font-bold uppercase tracking-widest transition-all border
                    <%= @filters['filter'] == 'all' ? 'bg-gold-500 text-obsidian-950 border-gold-500' : 'border-white/10 text-gray-300 hover:border-gold-500/50 hover:text-gold-400' %>">
            All
          </a>
        </div>

        <%# ===== Search Form ===== %>
        <%= form_with url: root_path, method: :get, local: true, id: "home-property-search-form" do %>
          <% if @filters['listing_type'].present? %>
            <input type="hidden" name="listing_type" value="<%= @filters['listing_type'] %>">
          <% end %>
          <% if @filters['property_type'].present? %>
            <input type="hidden" name="property_type" value="<%= @filters['property_type'] %>">
          <% end %>

          <div class="relative mb-5">
            <div class="flex rounded-2xl border border-white/10 bg-obsidian-950/70 overflow-hidden focus-within:border-gold-500/50 transition-colors">
              <span class="flex items-center pl-4 text-gold-500"><i class="fa-solid fa-magnifying-glass"></i></span>
              <input type="text"
                     name="keyword"
                     id="keyword-search"
                     value="<%= @filters['keyword'] %>"
                     data-placeholders="<%= (@placeholders.presence || []).to_json %>"
                     autocomplete="off"
                     placeholder="<%= @placeholders&.first || 'Search by title, city, or property type...' %>"
                     class="w-full bg-transparent px-4 py-3.5 text-sm text-white placeholder-gray-500 focus:outline-none">
              <button type="submit" class="bg-gold-500 hover:bg-gold-600 text-obsidian-950 font-bold uppercase text-xs tracking-widest px-6 transition-all flex items-center gap-2 whitespace-nowrap cursor-pointer">
                <i class="fa-solid fa-magnifying-glass"></i>
                <span class="hidden sm:inline">Search</span>
              </button>
            </div>

            <%# Autocomplete suggestions dropdown %>
            <div id="autocomplete-dropdown"
                 class="absolute top-full left-0 right-0 mt-1 bg-obsidian-900 border border-white/10 rounded-2xl overflow-hidden shadow-2xl z-50 hidden">
              <div id="autocomplete-results" class="max-h-72 overflow-y-auto"></div>
            </div>
          </div>

          <%# ===== Quick Filter Tags (Property Types) ===== %>
          <div class="mb-5">
            <span class="text-[10px] text-gray-500 uppercase tracking-widest font-medium block mb-2">Quick Filters</span>
            <div class="flex flex-wrap gap-2">
              <% quick_types = ['Apartment', 'Villa', 'Penthouse', 'Farmhouse', 'Office Space', 'Shop / Retail', 'Plot / Land', 'Industrial'] %>
              <% quick_types.each do |type| %>
                <% is_selected = @filters['property_type'].to_s.downcase == type.downcase %>
                <% tag_params = is_selected ? @filters.except('property_type') : @filters.merge(property_type: type) %>
                <a href="<%= root_path(tag_params) %>"
                   class="px-4 py-1.5 rounded-full text-[10px] font-semibold uppercase tracking-widest transition-all border
                          <%= is_selected ? 'bg-gold-500/20 text-gold-400 border-gold-500/50' : 'border-white/10 text-gray-400 hover:border-gold-500/30 hover:text-gold-400' %>">
                  <%= type %>
                </a>
              <% end %>
            </div>
          </div>

          <%# ===== Collapsible Advanced Filters ===== %>
          <details class="group" <%= 'open' if @filters['city'].present? || @filters['budget'].present? %>>
            <summary class="flex items-center gap-2 cursor-pointer text-[10px] text-gold-400 uppercase tracking-widest font-semibold mb-4 select-none">
              <i class="fa-solid fa-sliders"></i>
              <span>Advanced Filters</span>
              <i class="fa-solid fa-chevron-down text-[8px] transition-transform group-open:rotate-180"></i>
            </summary>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
              <div>
                <label class="block text-[10px] text-gold-400 font-semibold uppercase tracking-widest mb-2">City</label>
                <select name="city" class="w-full rounded-xl border border-white/10 bg-obsidian-950/70 px-3 py-2 text-sm text-white">
                  <option value="">Any City</option>
                  <% (@available_cities || []).each do |c| %>
                    <option value="<%= c %>" <%= 'selected' if @filters['city'].to_s.downcase == c.downcase %>><%= c %></option>
                  <% end %>
                </select>
              </div>
              <div>
                <label class="block text-[10px] text-gold-400 font-semibold uppercase tracking-widest mb-2">Property Type</label>
                <select name="property_type"
                        class="w-full rounded-xl border border-white/10 bg-obsidian-950/70 px-3 py-2 text-sm text-white">
                  <option value="">Any</option>
                  <% ['Residential', 'Commercial', 'Apartment', 'Villa', 'Penthouse', 'Farmhouse', 'Plot / Land', 'Office Space', 'Shop / Retail', 'Industrial'].each do |t| %>
                    <option value="<%= t %>" <%= 'selected' if @filters['property_type'].to_s.downcase == t.downcase %>><%= t %></option>
                  <% end %>
                </select>
              </div>
              <div>
                <label class="block text-[10px] text-gold-400 font-semibold uppercase tracking-widest mb-2">Budget</label>
                <select name="budget"
                        class="w-full rounded-xl border border-white/10 bg-obsidian-950/70 px-3 py-2 text-sm text-white">
                  <option value="">Any</option>
                  <option value="0-5000000" <%= 'selected' if @filters['budget'] == '0-5000000' %>>Under ₹50 Lakh</option>
                  <option value="0-15000000" <%= 'selected' if @filters['budget'] == '0-15000000' %>>Under ₹1.5 Cr</option>
                  <option value="0-30000000" <%= 'selected' if @filters['budget'] == '0-30000000' %>>Under ₹3.0 Cr</option>
                  <option value="0-50000000" <%= 'selected' if @filters['budget'] == '0-50000000' %>>Under ₹5.0 Cr</option>
                  <option value="0-100000000" <%= 'selected' if @filters['budget'] == '0-100000000' %>>Under ₹10.0 Cr</option>
                </select>
              </div>
            </div>
            <div class="mt-4 flex justify-end">
              <button type="submit" class="bg-gold-500 hover:bg-gold-600 text-obsidian-950 font-bold uppercase text-[10px] tracking-widest px-5 py-2 rounded-full transition-all">
                Apply Filters
              </button>
            </div>
          </details>
        <% end %>

        <%# ===== Active Filters Display ===== %>
        <% active_filters = @filters.select { |k, v| v.present? && !['filter'].include?(k) } %>
        <% if active_filters.any? %>
          <div class="flex flex-wrap items-center gap-2 mt-5 pt-4 border-t border-white/10">
            <span class="text-[10px] text-gray-400 uppercase tracking-widest font-semibold">Active:</span>
            <% active_filters.each do |key, value| %>
              <span class="inline-flex items-center gap-1.5 bg-gold-500/10 border border-gold-500/20 text-gold-400 text-[10px] font-semibold uppercase tracking-widest px-3 py-1 rounded-full">
                <%= key.humanize %>: <%= value %>
                <a href="<%= root_path(active_filters.except(key)) %>" class="text-gold-500 hover:text-white ml-1"><i class="fa-solid fa-xmark text-[8px]"></i></a>
              </span>
            <% end %>
            <a href="<%= root_path %>" class="text-[10px] text-gray-400 hover:text-gold-400 uppercase tracking-widest font-semibold ml-2 flex items-center gap-1">
              <i class="fa-solid fa-rotate-left text-[9px]"></i>
              <span>Clear All</span>
            </a>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="w-full py-12 md:py-16 flex items-center justify-center border-y border-gold-500/10 bg-black/60">
    <div class="w-full px-4 text-center">
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-white font-bold tracking-tight leading-tight mb-5">
        Trusted Properties. <span class="italic text-gold-400 font-normal">Transparent Ownership.</span>
      </h2>
      <p class="text-gray-300 text-sm md:text-base lg:text-lg max-w-3xl mx-auto tracking-wide font-light leading-relaxed">
        Unlock the best real estate finds — handpicked by experts and supercharged with machine learning algorithms.
      </p>
    </div>
  </div>

  <%# ===== BROWSE BY PROPERTY CITY ===== %>
  <div class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-b border-white/5">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8">
      <div>
        <span class="text-gold-500 font-semibold tracking-[0.25em] text-xs uppercase block mb-3">Popular Locations</span>
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl text-white font-bold leading-tight tracking-tight">Browse by Property City</h2>
      </div>
      <p class="text-gray-400 text-xs md:text-sm mt-3 md:mt-0 max-w-md">Explore premium real estate in top cities across the country.</p>
    </div>

    <!-- Single horizontal row with overlay move buttons -->
    <div class="relative group/cities">
      <button type="button"
              onclick="scrollCitiesLeft()"
              aria-label="Scroll left"
              class="absolute left-1 top-1/2 -translate-y-1/2 z-20 text-white/80 hover:text-gold-400 text-3xl sm:text-4xl font-bold bg-transparent border-0 p-2 cursor-pointer transition-opacity duration-300 opacity-0 group-hover/cities:opacity-100 pointer-events-none group-hover/cities:pointer-events-auto drop-shadow-[0_4px_10px_rgba(0,0,0,0.8)]">
        <i class="fa-solid fa-chevron-left"></i>
      </button>

      <div id="cities-scroll-container" class="flex gap-6 overflow-x-auto pb-4 pt-1 snap-x snap-mandatory scroll-smooth scrollbar-none px-1">
        <% cities_to_display = @cities.presence || (@available_cities || []).map { |c| City.find_by(name: c) || City.new(name: c) } %>
        <% cities_to_display.each do |c_obj| %>
          <% city_name = c_obj.name %>
          <% city_count = Property.active_listings.where("city ILIKE ?", city_name).count %>
          <% next if city_count == 0 %>
          <% img_src = c_obj.respond_to?(:display_image_url) ? c_obj.display_image_url : 'https://images.unsplash.com/photo-1571210983196-17b1ff4473de?auto=format&fit=crop&w=800&q=80' %>
          <a href="<%= properties_path(city: city_name) %>" class="snap-start flex-none w-72 md:w-80 group relative rounded-3xl overflow-hidden glass-card h-[360px] flex flex-col justify-end p-6 border border-white/10 hover:border-gold-500/50 transition-all duration-500">
            <img src="<%= img_src %>" alt="<%= city_name %>" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-75 group-hover:opacity-95">
            <div class="absolute inset-0 bg-gradient-to-t from-obsidian-950 via-obsidian-950/40 to-transparent"></div>
            <div class="relative z-10">
              <span class="text-[10px] font-bold uppercase tracking-widest text-gold-400 block mb-1">
                <%= city_count %> <%= 'Listing'.pluralize(city_count) %>
              </span>
              <h3 class="font-serif text-xl font-bold text-white group-hover:text-gold-400 transition-colors flex items-center justify-between">
                <span><%= city_name %></span>
                <i class="fa-solid fa-arrow-right text-xs opacity-0 group-hover:opacity-100 transition-all group-hover:translate-x-1 text-gold-400"></i>
              </h3>
            </div>
          </a>
        <% end %>
      </div>

      <button type="button"
              onclick="scrollCitiesRight()"
              aria-label="Scroll right"
              class="absolute right-1 top-1/2 -translate-y-1/2 z-20 text-white/80 hover:text-gold-400 text-3xl sm:text-4xl font-bold bg-transparent border-0 p-2 cursor-pointer transition-opacity duration-300 opacity-0 group-hover/cities:opacity-100 pointer-events-none group-hover/cities:pointer-events-auto drop-shadow-[0_4px_10px_rgba(0,0,0,0.8)]">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>
  </div>

  <script>
    function scrollCitiesLeft() {
      const container = document.getElementById("cities-scroll-container");
      if (container) container.scrollBy({ left: -320, behavior: 'smooth' });
    }
    function scrollCitiesRight() {
      const container = document.getElementById("cities-scroll-container");
      if (container) container.scrollBy({ left: 320, behavior: 'smooth' });
    }
  </script>

  <%# ===== SHOWCASE SECTIONS (LATEST PROJECTS OR SEARCH RESULTS) ===== %>
  <% if @is_filtered %>
    <% section_title = @filters['filter'] == 'all' ? "All Properties" : "Search Results" %>
    <% section_subtitle = @filters['filter'] == 'all' ? "All Available Listings" : "Filtered Properties" %>
    <% showcase_sections = [
         { key: "search_results", title: section_title, subtitle: section_subtitle, properties: @filtered_properties, path: properties_path(@filters), is_grid: false }
       ] %>
  <% else %>
    <% showcase_sections = [
         { key: "latest", title: "Latest Projects", subtitle: "New Launches & Developments", properties: @latest_projects, path: properties_path(section: 'latest_projects'), is_grid: false }
       ] %>
  <% end %>

  <% showcase_sections.each do |sec| %>
    <% if sec[:properties].present? && sec[:properties].any? %>
      <div class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-b border-white/5">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-8">
          <div>
            <span class="text-gold-500 font-semibold tracking-[0.25em] text-xs uppercase block mb-3"><%= sec[:subtitle] %></span>
            <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl text-white font-bold leading-tight tracking-tight"><%= sec[:title] %></h2>
          </div>
          <div class="mt-6 md:mt-0 flex items-center">
            <%= link_to sec[:path], class: "group text-gold-400 hover:text-gold-500 text-xs md:text-sm tracking-widest font-semibold uppercase flex items-center space-x-2 transition-all border border-gold-500/20 px-5 py-2.5 rounded-full hover:border-gold-500 hover:bg-gold-500/10" do %>
              <span>View All</span>
              <i class="fa-solid fa-arrow-right transition-transform group-hover:translate-x-1"></i>
            <% end %>
          </div>
        </div>

        <% if sec[:is_grid] %>
          <%# ===== GRID LAYOUT FOR FILTER RESULTS (MULTIPLE ROWS) ===== %>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% sec[:properties].each do |property| %>
              <div class="w-full tilt-wrapper">
                <% img_urls = property.property_images.map { |pi| (pi.respond_to?(:image) && pi.image.attached?) ? url_for(pi.image) : pi.image_url }.compact_blank %>
                <article class="glass-card cursor-pointer overflow-hidden rounded-3xl shadow-xl flex flex-col group h-full"
                         data-property-modal-trigger="true"
                         data-id="<%= property.id %>"
                         data-title="<%= j(property.title) %>"
                         data-description="<%= j(property.description.to_s) %>"
                         data-price="<%= property.price.to_i %>"
                         data-city="<%= j(property.city.to_s) %>"
                         data-address="<%= j(property.address.to_s) %>"
                         data-property-type="<%= j(property.property_type.to_s) %>"
                         data-bedrooms="<%= property.bedrooms %>"
                         data-bathrooms="<%= property.bathrooms %>"
                         data-area="<%= property.area %>"
                         data-image-url="<%= img_urls.first.to_s %>"
                         data-images="<%= img_urls.to_json %>"
                         onmousemove="handleCardTilt(event, this)"
                         onmouseleave="resetCardTilt(this)">
                  <div class="relative h-60 overflow-hidden bg-black">
                    <% if img_urls.first.present? %>
                      <img src="<%= img_urls.first %>" alt="<%= property.title %>" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110">
                    <% else %>
                      <div class="h-full w-full bg-gradient-to-br from-gold-500/20 to-obsidian-900 flex flex-col items-center justify-center text-gold-400 p-4">
                        <i class="fa-solid fa-building text-3xl mb-2 opacity-50"></i>
                        <span class="text-[10px] tracking-widest uppercase font-semibold text-gray-400">DUA Real Estate</span>
                      </div>
                    <% end %>
                    <div class="absolute inset-0 bg-gradient-to-t from-obsidian-950 via-transparent"></div>
                    <% p_status = property.status.presence || 'Active' %>
                    <% status_style = case p_status.to_s.downcase
                       when 'active'   then 'bg-emerald-500/90 text-obsidian-950 border-emerald-400/50'
                       when 'sold'     then 'bg-red-500/90 text-white border-red-400/50'
                       when 'pending'  then 'bg-amber-500/90 text-obsidian-950 border-amber-400/50'
                       when 'inactive' then 'bg-gray-600/90 text-gray-200 border-gray-500/50'
                       else                 'bg-gold-500/90 text-obsidian-950 border-gold-400/50'
                       end %>
                    <div class="absolute top-4 right-4 z-10">
                      <span class="<%= status_style %> border font-bold tracking-widest text-[9px] uppercase px-3 py-1 rounded-full shadow-lg backdrop-blur-md">
                        <%= p_status %>
                      </span>
                    </div>
                    <div class="absolute bottom-4 left-4 flex items-center gap-2">
                      <span class="bg-obsidian-950/90 border border-gold-500/40 text-gold-400 font-bold tracking-widest text-[9px] uppercase px-3 py-1 rounded-full"><%= property.listing_type %></span>
                      <span class="bg-gold-500 text-obsidian-950 font-bold tracking-widest text-[9px] uppercase px-3 py-1 rounded-full"><%= property.property_type %></span>
                    </div>
                  </div>
                  <div class="p-6 flex-grow flex flex-col justify-between space-y-4">
                    <div>
                      <p class="text-gold-400 text-[10px] tracking-widest uppercase font-medium mb-1"><i class="fa-solid fa-location-dot mr-1"></i> <%= [property.city, property.country].compact_blank.join(', ') %></p>
                      <h3 class="font-serif text-xl text-white mb-2 group-hover:text-gold-400 transition-colors line-clamp-1"><%= property.title %></h3>
                      <p class="text-gray-400 text-xs leading-relaxed line-clamp-2"><%= truncate(property.description, length: 100) %></p>
                    </div>
                    <div class="grid grid-cols-3 gap-2 border-t border-white/5 pt-4 text-center">
                      <div>
                        <span class="block text-[8px] tracking-widest text-gray-500 uppercase">Est. Area</span>
                        <span class="text-xs text-white font-medium"><%= number_with_delimiter(property.area) %> <%= property.area_unit.presence || 'sq ft' %></span>
                      </div>
                      <div class="border-x border-white/5">
                        <span class="block text-[8px] tracking-widest text-gray-500 uppercase">Configuration</span>
                        <span class="text-xs text-white font-medium"><%= property.bedrooms %> Bed</span>
                      </div>
                      <div>
                        <span class="block text-[8px] tracking-widest text-gray-500 uppercase">Bathrooms</span>
                        <span class="text-xs text-white font-medium"><%= property.bathrooms %> Bath</span>
                      </div>
                    </div>
                    <div class="flex items-center justify-between border-t border-white/5 pt-4">
                      <div>
                        <span class="text-[9px] text-gray-500 uppercase tracking-widest block"><%= property.listing_type %></span>
                        <p class="text-gold-400 text-lg font-serif font-semibold">₹<%= number_with_delimiter(property.price.to_i) %></p>
                      </div>
                      <button type="button" class="text-xs text-gold-400 uppercase tracking-widest font-bold group-hover:translate-x-1.5 transition-transform flex items-center space-x-1">
                        <span>View Details</span>
                        <i class="fa-solid fa-chevron-right text-[10px]"></i>
                      </button>
                    </div>
                  </div>
                </article>
              </div>
            <% end %>
          </div>
        <% else %>
          <%# ===== CAROUSEL LAYOUT (SINGLE ROW HORIZONTAL SCROLL) ===== %>
          <div class="relative group/carousel">
            <button type="button"
                    onclick="scrollPropSectionLeft('<%= sec[:key] %>')"
                    aria-label="Scroll left"
                    class="absolute left-1 top-1/2 -translate-y-1/2 z-20 text-white/80 hover:text-gold-400 text-3xl sm:text-4xl font-bold bg-transparent border-0 p-2 cursor-pointer transition-opacity duration-300 opacity-0 group-hover/carousel:opacity-100 pointer-events-none group-hover/carousel:pointer-events-auto drop-shadow-[0_4px_10px_rgba(0,0,0,0.8)]">
              <i class="fa-solid fa-chevron-left"></i>
            </button>

            <div id="prop-section-scroll-<%= sec[:key] %>" class="flex gap-6 overflow-x-auto pb-6 pt-1 snap-x snap-mandatory scroll-smooth scrollbar-none px-1">
              <% sec[:properties].take(10).each do |property| %>
                <div class="snap-start flex-none w-[300px] sm:w-[340px] tilt-wrapper">
                  <% img_urls = property.property_images.map { |pi| (pi.respond_to?(:image) && pi.image.attached?) ? url_for(pi.image) : pi.image_url }.compact_blank %>
                  <article class="glass-card cursor-pointer overflow-hidden rounded-3xl shadow-xl flex flex-col group h-full"
                           data-property-modal-trigger="true"
                           data-id="<%= property.id %>"
                           data-title="<%= j(property.title) %>"
                           data-description="<%= j(property.description.to_s) %>"
                           data-price="<%= property.price.to_i %>"
                           data-city="<%= j(property.city.to_s) %>"
                           data-address="<%= j(property.address.to_s) %>"
