                    <div class="flex items-center space-x-1 bg-obsidian-950 border border-gold-500/30 rounded-lg px-2.5 py-1 focus-within:border-gold-500 transition-colors">
                      <span class="text-gold-400 text-xs font-bold">₹</span>
                      <input type="number" id="standalone-calc-val-input" min="5000000" max="250000000" step="100000" value="35000000" class="bg-transparent text-gold-400 font-semibold text-xs text-right w-28 outline-none">
                    </div>
                  </div>
                  <input type="range" id="standalone-calc-val" min="5000000" max="250000000" step="100000" value="35000000" class="w-full h-1 bg-gray-800 rounded-lg appearance-none cursor-pointer accent-gold-500">
