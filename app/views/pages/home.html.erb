<script>
  function formatCurrency(value) {
    return new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 0 }).format(value);
  }

  function calculateLoan() {
    const valInput = document.getElementById("standalone-calc-val-input");
    const valSlider = document.getElementById("standalone-calc-val");

    const downInput = document.getElementById("standalone-calc-down-input");
    const downSlider = document.getElementById("standalone-calc-down");

    const rateInput = document.getElementById("standalone-calc-rate-input");
    const rateSlider = document.getElementById("standalone-calc-rate");

    const termInput = document.getElementById("standalone-calc-term-input");
    const termSlider = document.getElementById("standalone-calc-term");

    const propertyValue = Number(valSlider?.value || 0);
    const downVal = Number(downSlider?.value || 20);
    const rateVal = Number(rateSlider?.value || 8.5);
    const years = Number(termSlider?.value || 20);

    const downPercent = downVal / 100;
    const annualRate = rateVal / 100;
    const downPayment = propertyValue * downPercent;
    const loanAmount = propertyValue - downPayment;
    const monthlyRate = annualRate / 12;
    const months = years * 12;
    const payment = monthlyRate > 0 ? (loanAmount * monthlyRate) / (1 - Math.pow(1 + monthlyRate, -months)) : loanAmount / months;
    const totalPaid = payment * months;
    const totalInterest = totalPaid - loanAmount;

    const formattedValEl = document.getElementById("standalone-calc-val-formatted");
    if (formattedValEl) formattedValEl.textContent = formatCurrency(propertyValue);

    const downAmtEl = document.getElementById("standalone-calc-down-amount");
    if (downAmtEl) downAmtEl.textContent = formatCurrency(downPayment);

    document.getElementById("standalone-val-financed").textContent = formatCurrency(loanAmount);
    document.getElementById("standalone-val-interest").textContent = formatCurrency(totalInterest);
    document.getElementById("standalone-val-monthly").textContent = `${formatCurrency(payment)}/mo`;
  }

  function bindTwoWayCalculatorInput(inputId, sliderId, min, max, isFloat = false) {
    const inputEl = document.getElementById(inputId);
    const sliderEl = document.getElementById(sliderId);

    if (!inputEl || !sliderEl) return;

    // When slider changes -> update text input
    sliderEl.addEventListener("input", function () {
      inputEl.value = sliderEl.value;
      calculateLoan();
    });

    // When user types manually -> auto-clamp to max on input
    inputEl.addEventListener("input", function () {
      let val = isFloat ? parseFloat(inputEl.value) : parseInt(inputEl.value, 10);
      if (!isNaN(val) && val > max) {
        val = max;
        inputEl.value = max;
      }
      if (!isNaN(val) && val >= min && val <= max) {
        sliderEl.value = val;
        calculateLoan();
      }
    });

    // When user finishes typing (blur/change) -> auto-clamp to min if too small
    inputEl.addEventListener("change", function () {
      let val = isFloat ? parseFloat(inputEl.value) : parseInt(inputEl.value, 10);
      if (isNaN(val) || val < min) {
        val = min;
        inputEl.value = min;
      } else if (val > max) {
        val = max;
        inputEl.value = max;
      }
      sliderEl.value = val;
      calculateLoan();
    });
  }

  function initializeStandaloneCalculator() {
    bindTwoWayCalculatorInput("standalone-calc-val-input", "standalone-calc-val", 5000000, 250000000, false);
    bindTwoWayCalculatorInput("standalone-calc-down-input", "standalone-calc-down", 10, 80, false);
    bindTwoWayCalculatorInput("standalone-calc-rate-input", "standalone-calc-rate", 2.0, 15.0, true);
    bindTwoWayCalculatorInput("standalone-calc-term-input", "standalone-calc-term", 5, 30, false);

    calculateLoan();
  }

  document.addEventListener("turbo:load", initializeStandaloneCalculator);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeStandaloneCalculator);
  } else {
    initializeStandaloneCalculator();
  }
</script>
