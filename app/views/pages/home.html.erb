        <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-5 space-y-6">
            <span class="text-gold-500 font-semibold tracking-[0.25em] text-xs uppercase block">Financial Architecture</span>
            <h2 class="font-serif text-3xl md:text-4xl text-white font-bold leading-tight">Mortgage & Liquidity Planning</h2>
