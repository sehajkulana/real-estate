<% content_for :title, "About Us | Dua Real Estate – Building Trust, Creating Value" %>

<div class="relative overflow-hidden pt-6 pb-20">
  <!-- Subtle Background Glow Effects -->
  <div class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-[600px] w-[1000px] -translate-x-1/2 rounded-full bg-gradient-to-tr from-gold-500/10 via-amber-500/5 to-transparent blur-3xl"></div>
  <div class="pointer-events-none absolute top-1/2 -right-40 -z-10 h-[500px] w-[500px] rounded-full bg-gold-500/5 blur-3xl"></div>

  <!-- Hero Banner Header -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-8 pb-16">
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-gold-500/30 bg-gold-500/10 text-gold-400 text-xs font-semibold uppercase tracking-[0.25em] mb-6 backdrop-blur-md shadow-inner">
      <i class="fa-solid fa-crown text-gold-400 text-xs"></i>
      <span>About Dua Real Estate</span>
    </div>
    
    <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-white font-extrabold tracking-tight leading-tight max-w-4xl mx-auto">
      Building Trust, <span class="text-transparent bg-clip-text bg-gradient-to-r from-gold-300 via-gold-400 to-amber-500 gold-glow">Creating Value</span>
    </h1>

    <p class="mt-6 text-gray-300 text-lg sm:text-xl max-w-3xl mx-auto font-light leading-relaxed">
      Empowering individuals, families, and investors across India and beyond with transparent advisory, unyielding integrity, and high-value real estate opportunities.
    </p>

    <!-- Key Header Badges -->
    <div class="mt-10 flex flex-wrap justify-center items-center gap-4 text-xs font-medium text-gray-300">
      <div class="flex items-center gap-2 px-4 py-2.5 rounded-xl border border-white/10 bg-white/5 backdrop-blur-md">
        <i class="fa-solid fa-shield-halved text-gold-400"></i>
        <span>100% Verified Deals</span>
      </div>
      <div class="flex items-center gap-2 px-4 py-2.5 rounded-xl border border-white/10 bg-white/5 backdrop-blur-md">
        <i class="fa-solid fa-handshake-angle text-gold-400"></i>
        <span>Transparent Guidance</span>
      </div>
      <div class="flex items-center gap-2 px-4 py-2.5 rounded-xl border border-white/10 bg-white/5 backdrop-blur-md">
        <i class="fa-solid fa-earth-asia text-gold-400"></i>
        <span>Pan-India & Global Vision</span>
      </div>
    </div>
  </section>

  <!-- Founder Spotlight Section (Arun Kumar) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="relative rounded-3xl border border-gold-500/20 bg-gradient-to-b from-obsidian-900/90 to-obsidian-950/90 p-8 sm:p-12 backdrop-blur-xl shadow-2xl overflow-hidden">
      <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-gold-500/5 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Founder Image / Executive Card -->
        <div class="lg:col-span-5 relative group">
          <div class="relative rounded-2xl overflow-hidden border border-gold-500/30 shadow-2xl bg-obsidian-900">
            <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=1000&q=80" alt="Arun Kumar - Founder, Dua Real Estate" class="w-full h-[450px] object-cover object-top transition-transform duration-700 group-hover:scale-105">
            <div class="absolute inset-0 bg-gradient-to-t from-obsidian-950 via-obsidian-950/20 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 p-4 rounded-xl border border-white/10 bg-obsidian-950/80 backdrop-blur-md">
              <h3 class="text-xl font-bold font-serif text-white">Arun Kumar</h3>
              <p class="text-xs uppercase tracking-widest text-gold-400 font-semibold mt-1">Founder & Managing Director</p>
              <div class="mt-3 flex items-center justify-between border-t border-white/10 pt-2 text-[11px] text-gray-400">
                <span><i class="fa-solid fa-building-shield text-gold-400 mr-1"></i> Dua Real Estate</span>
                <span class="text-gold-300 font-medium">India & Global</span>
              </div>
            </div>
          </div>
          <!-- Decorative frame element -->
          <div class="absolute -inset-2 rounded-3xl border border-gold-500/20 -z-10 transition-all duration-300 group-hover:border-gold-500/40"></div>
        </div>

        <!-- Founder Story & Message -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-gold-500/10 text-gold-400 text-[11px] font-bold uppercase tracking-wider">
            <i class="fa-solid fa-user-tie"></i> Founder's Message
          </div>
          
          <h2 class="font-serif text-3xl sm:text-4xl text-white font-bold leading-tight">
            "Every property is more than just land or a building—it's a place where <span class="text-gold-400">dreams begin</span>."
          </h2>

          <div class="space-y-4 text-gray-300 text-base leading-relaxed font-light">
            <p>
              My name is <strong class="text-white font-semibold">Arun Kumar</strong>, founder of <strong class="text-gold-400 font-semibold">Dua Real Estate</strong>. I am deeply passionate about helping people buy, sell, and invest in real estate properties with complete confidence, security, and peace of mind.
            </p>

            <p>
              My primary goal has always been simple yet resolute: to provide honest advice, transparent dealings, and the best property options tailored to every client’s unique needs. Whether you are looking for strategic residential plots, commercial properties, lucrative investment opportunities, or your dream family home, I am personally committed to providing reliable service and total customer satisfaction.
            </p>

            <p>
              At Dua Real Estate, we don't just close transactions—we focus on building long-term relationships through trust, integrity, and professional service. Our clear vision is to grow Dua Real Estate into a household name and trusted real estate brand across India, and eventually around the world.
            </p>
          </div>

          <!-- Highlight Cards -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-white/10">
            <div class="flex items-start gap-3 p-3.5 rounded-xl border border-white/5 bg-white/[0.02]">
              <div class="w-10 h-10 rounded-lg bg-gold-500/10 border border-gold-500/20 flex items-center justify-center text-gold-400 shrink-0">
                <i class="fa-solid fa-handshake"></i>
              </div>
              <div>
                <h4 class="text-sm font-semibold text-white">Transparent Dealings</h4>
                <p class="text-xs text-gray-400 mt-0.5">Honest valuation, clear titles, and zero hidden costs.</p>
              </div>
            </div>

            <div class="flex items-start gap-3 p-3.5 rounded-xl border border-white/5 bg-white/[0.02]">
              <div class="w-10 h-10 rounded-lg bg-gold-500/10 border border-gold-500/20 flex items-center justify-center text-gold-400 shrink-0">
                <i class="fa-solid fa-heart"></i>
              </div>
              <div>
                <h4 class="text-sm font-semibold text-white">Long-Term Relationships</h4>
                <p class="text-xs text-gray-400 mt-0.5">Client satisfaction above sales, supporting you for life.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Statistics Counter Grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      <div class="rounded-2xl border border-white/10 bg-obsidian-900/80 p-6 text-center backdrop-blur-md hover:border-gold-500/40 transition-all duration-300">
        <div class="font-serif text-3xl sm:text-4xl font-extrabold text-gold-400 gold-glow mb-1">100%</div>
        <p class="text-xs uppercase tracking-widest text-gray-400 font-medium">Transparent & Verified</p>
      </div>

      <div class="rounded-2xl border border-white/10 bg-obsidian-900/80 p-6 text-center backdrop-blur-md hover:border-gold-500/40 transition-all duration-300">
        <div class="font-serif text-3xl sm:text-4xl font-extrabold text-gold-400 gold-glow mb-1">1,200+</div>
        <p class="text-xs uppercase tracking-widest text-gray-400 font-medium">Happy Clients & Families</p>
      </div>

      <div class="rounded-2xl border border-white/10 bg-obsidian-900/80 p-6 text-center backdrop-blur-md hover:border-gold-500/40 transition-all duration-300">
        <div class="font-serif text-3xl sm:text-4xl font-extrabold text-gold-400 gold-glow mb-1">₹500Cr+</div>
        <p class="text-xs uppercase tracking-widest text-gray-400 font-medium">Property Value Advised</p>
      </div>

      <div class="rounded-2xl border border-white/10 bg-obsidian-900/80 p-6 text-center backdrop-blur-md hover:border-gold-500/40 transition-all duration-300">
        <div class="font-serif text-3xl sm:text-4xl font-extrabold text-gold-400 gold-glow mb-1">Pan-India</div>
        <p class="text-xs uppercase tracking-widest text-gray-400 font-medium">& Global Growth Vision</p>
      </div>
    </div>
  </section>

  <!-- What We Offer: Core Real Estate Verticals -->
