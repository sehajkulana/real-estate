    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Card 1: Residential Plots -->
      <a href="<%= properties_path(property_type: 'Plot / Land') %>" class="rounded-2xl border border-white/10 bg-obsidian-900 p-6 hover:border-gold-500/50 transition-all duration-300 group flex flex-col justify-between block">
        <div>
          <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-500/20 flex items-center justify-center text-gold-400 text-xl mb-5 group-hover:scale-110 transition-transform">
