<section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
    <div>
      <span class="text-gold-500 font-semibold tracking-[0.25em] text-xs uppercase block mb-3">Contact</span>
      <h1 class="font-serif text-4xl md:text-5xl text-white font-bold leading-tight">Let’s begin your next move</h1>
      <p class="text-gray-400 mt-6 text-lg leading-relaxed">Share your goals and our advisors will coordinate a private consultation tailored to your preferred property type, location, and investment profile.</p>
      <div class="mt-8 space-y-4 text-gray-300">
        <p><i class="fa-solid fa-location-dot text-gold-500 mr-2"></i> 88 Marina Avenue, Downtown District</p>
        <p><i class="fa-solid fa-phone text-gold-500 mr-2"></i> +1 (555) 123-4567</p>
        <p><i class="fa-solid fa-envelope text-gold-500 mr-2"></i> hello@duarealestate.com</p>
      </div>
    </div>
    <div class="glass-card rounded-3xl p-8">
      <%= form_with url: create_inquiry_path, method: :post, local: true, class: "space-y-5", data: { require_login: (!user_signed_in?).to_s } do |f| %>
        <div>
          <label class="block text-sm text-gray-300 mb-2">Name <span class="text-red-400">*</span></label>
          <%= f.text_field :name, required: true, placeholder: "Your name", class: "w-full rounded-2xl border border-white/10 bg-obsidian-950/70 px-4 py-3 text-white" %>
        </div>
        <div>
          <label class="block text-sm text-gray-300 mb-2">Email <span class="text-red-400">*</span></label>
          <%= f.email_field :email, required: true, placeholder: "Your email", class: "w-full rounded-2xl border border-white/10 bg-obsidian-950/70 px-4 py-3 text-white" %>
        </div>
        <div>
          <label class="block text-sm text-gray-300 mb-2">Phone</label>
          <%= f.telephone_field :phone, placeholder: "Your phone number", class: "w-full rounded-2xl border border-white/10 bg-obsidian-950/70 px-4 py-3 text-white" %>
        </div>
        <div>
          <label class="block text-sm text-gray-300 mb-2">Message <span class="text-red-400">*</span></label>
          <%= f.text_area :message, required: true, rows: 4, placeholder: "Tell us about your ideal property...", class: "w-full rounded-2xl border border-white/10 bg-obsidian-950/70 px-4 py-3 text-white" %>
        </div>
        <%= f.submit "Send Inquiry", class: "w-full bg-gold-500 hover:bg-gold-600 text-obsidian-950 font-semibold uppercase text-xs py-3 px-4 rounded-full transition-all cursor-pointer" %>
      <% end %>
    </div>
  </div>
</section>
