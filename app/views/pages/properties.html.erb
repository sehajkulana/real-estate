<section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="mb-12">
    <span class="text-gold-500 font-semibold tracking-[0.25em] text-xs uppercase block mb-3">Signature Portfolio</span>
    <h1 class="font-serif text-4xl md:text-5xl text-white font-bold leading-tight">Curated Premium Listings</h1>
    <p class="text-gray-400 mt-4 max-w-2xl">Explore luxury residences and commercial spaces selected for sophistication, location, and investment potential.</p>
  </div>

  <div class="glass-card rounded-3xl p-6 md:p-8 mb-10">
    <%= form_with url: properties_path, method: :get, local: true, class: "grid grid-cols-1 md:grid-cols-4 gap-4" do %>
      <div>
        <label class="block text-[10px] text-gold-400 font-semibold uppercase tracking-widest mb-2">City</label>
        <%= text_field_tag :city, @filters["city"], class: "w-full rounded-xl border border-white/10 bg-obsidian-950/70 px-3 py-2 text-sm text-white" %>
      </div>
      <div>
        <label class="block text-[10px] text-gold-400 font-semibold uppercase tracking-widest mb-2">Property Type</label>
        <%= select_tag :property_type, options_for_select([['Any', ''], ['Residential', 'Residential'], ['Commercial', 'Commercial']], @filters["property_type"]), class: "w-full rounded-xl border border-white/10 bg-obsidian-950/70 px-3 py-2 text-sm text-white" %>
      </div>
      <div>
        <label class="block text-[10px] text-gold-400 font-semibold uppercase tracking-widest mb-2">Budget</label>
        <%= select_tag :budget, options_for_select([['Any', ''], ['Under $1.5M', '0-1500000'], ['Under $3.0M', '0-3000000'], ['Under $5.0M', '0-5000000']], @filters["budget"]), class: "w-full rounded-xl border border-white/10 bg-obsidian-950/70 px-3 py-2 text-sm text-white" %>
      </div>
      <div class="flex items-end">
        <%= submit_tag "Search", class: "w-full bg-gold-500 hover:bg-gold-600 text-obsidian-950 font-semibold uppercase text-xs py-3 px-4 rounded-full transition-all" %>
      </div>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <% @properties.each do |property| %>
      <article class="glass-card rounded-3xl overflow-hidden">
        <% if property.property_images.first&.image&.attached? %>
          <%= image_tag property.property_images.first.image, class: "h-64 w-full object-cover" %>
        <% else %>
          <div class="h-64 w-full bg-gradient-to-br from-gold-500/20 to-obsidian-900"></div>
        <% end %>
        <div class="p-7">
          <div class="flex items-center justify-between text-xs uppercase tracking-[0.25em] text-gray-400 mb-4">
            <span><%= property.property_type %></span>
            <span><%= property.city %></span>
          </div>
          <h3 class="font-serif text-2xl text-white mb-3"><%= property.title %></h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-5"><%= truncate(property.description, length: 120) %></p>
          <div class="flex items-center justify-between">
            <p class="text-gold-400 font-semibold">$<%= number_with_delimiter(property.price.to_i) %></p>
            <%= link_to "View Details", property_path(property), class: "text-sm text-gold-400 hover:text-gold-300" %>
          </div>
        </div>
      </article>
    <% end %>
  </div>
</section>
