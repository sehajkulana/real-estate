<% content_for :title, "Uptown - Properties" %>

<nav class="navbar navbar-expand-lg navbar-dark ftco_navbar bg-dark ftco-navbar-light" id="ftco-navbar">
  <div class="container">
    <a class="navbar-brand" href="<%= root_path %>">Uptown</a>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#ftco-nav" aria-controls="ftco-nav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="oi oi-menu"></span> Menu
    </button>

    <div class="collapse navbar-collapse" id="ftco-nav">
      <ul class="navbar-nav ml-auto">
        <li class="nav-item"><a href="<%= root_path %>" class="nav-link">Home</a></li>
        <li class="nav-item"><a href="<%= about_path %>" class="nav-link">About</a></li>
        <li class="nav-item"><a href="<%= agent_path %>" class="nav-link">Agent</a></li>
        <li class="nav-item"><a href="<%= services_path %>" class="nav-link">Services</a></li>
        <li class="nav-item active"><a href="<%= properties_path %>" class="nav-link">Properties</a></li>
        <li class="nav-item"><a href="<%= blog_path %>" class="nav-link">Blog</a></li>
        <li class="nav-item"><a href="<%= contact_path %>" class="nav-link">Contact</a></li>
      </ul>
    </div>
  </div>
</nav>

<section class="hero-wrap hero-wrap-2 ftco-degree-bg js-fullheight" style="background-image: url('/uptown/images/bg_1.jpg');" data-stellar-background-ratio="0.5">
  <div class="overlay"></div>
  <div class="container">
    <div class="row no-gutters slider-text js-fullheight align-items-center justify-content-center">
      <div class="col-md-9 ftco-animate pb-5 text-center">
        <p class="breadcrumbs"><span class="mr-2"><a href="<%= root_path %>">Home <i class="ion-ios-arrow-forward"></i></a></span> <span>Properties <i class="ion-ios-arrow-forward"></i></span></p>
        <h1 class="mb-3 bread">Choose <br>Your Desired Home</h1>
      </div>
    </div>
  </div>
</section>

<section class="ftco-section">
  <div class="container">
    <input type="hidden" id="searched-city" name="city" value="<%= @search_city %>">
    <div class="row">
      <% @properties.each do |property| %>
        <% cover_image = property.property_images.find(&:is_cover?) || property.property_images.first %>
        <% image_url = cover_image&.image&.attached? ? url_for(cover_image.image) : "/uptown/images/work-1.jpg" %>
        <div class="col-md-4">
          <div class="property-wrap ftco-animate">
            <a href="<%= property_path(property) %>" class="img" style="background-image: url('<%= image_url %>');"></a>
            <div class="text">
              <p class="price"><span class="orig-price"><%= number_to_currency(property.price || 0, unit: "₹", precision: 0) %></span></p>
              <ul class="property_list">
                <li><span class="flaticon-bed"></span><%= property.bedrooms || 0 %></li>
                <li><span class="flaticon-bathtub"></span><%= property.bathrooms || 0 %></li>
                <li><span class="flaticon-floor-plan"></span><%= [property.area, property.area_unit].compact.join(" ").presence || "Not specified" %></li>
              </ul>
              <h3><a href="<%= property_path(property) %>"><%= property.title %></a></h3>
              <span class="location"><%= [property.city, property.state].compact_blank.join(", ").presence || "Location not specified" %></span>
              <a href="<%= property_path(property) %>" class="d-flex align-items-center justify-content-center btn-custom">
                <span class="ion-ios-link"></span>
              </a>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="row mt-5 d-none">
      <div class="col text-center">
        <div class="block-27">
          <ul>
            <li><a href="#">&lt;</a></li>
            <li class="active"><span>1</span></li>
            <li><a href="#">2</a></li>
            <li><a href="#">3</a></li>
            <li><a href="#">4</a></li>
            <li><a href="#">5</a></li>
            <li><a href="#">&gt;</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

