<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Uptown - Real Estate" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Real Estate">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://fonts.googleapis.com/css?family=Nunito+Sans:200,300,400,600,700,800,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/uptown/css/open-iconic-bootstrap.min.css">
    <link rel="stylesheet" href="/uptown/css/animate.css">
    <link rel="stylesheet" href="/uptown/css/owl.carousel.min.css">
    <link rel="stylesheet" href="/uptown/css/owl.theme.default.min.css">
    <link rel="stylesheet" href="/uptown/css/magnific-popup.css">
    <link rel="stylesheet" href="/uptown/css/aos.css">
    <link rel="stylesheet" href="/uptown/css/ionicons.min.css">
    <link rel="stylesheet" href="/uptown/css/bootstrap-datepicker.css">
    <link rel="stylesheet" href="/uptown/css/jquery.timepicker.css">
    <link rel="stylesheet" href="/uptown/css/flaticon.css">
    <link rel="stylesheet" href="/uptown/css/icomoon.css">
    <link rel="stylesheet" href="/uptown/css/style.css">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= yield %>

    <div id="ftco-loader" class="show fullscreen"><svg class="circular" width="48px" height="48px"><circle class="path-bg" cx="24" cy="24" r="22" fill="none" stroke-width="4" stroke="#eeeeee"/><circle class="path" cx="24" cy="24" r="22" fill="none" stroke-width="4" stroke-miterlimit="10" stroke="#F96D00"/></svg></div>

    <script src="/uptown/js/jquery.min.js"></script>
    <script src="/uptown/js/jquery-migrate-3.0.1.min.js"></script>
    <script src="/uptown/js/popper.min.js"></script>
    <script src="/uptown/js/bootstrap.min.js"></script>
    <script src="/uptown/js/jquery.easing.1.3.js"></script>
    <script src="/uptown/js/jquery.waypoints.min.js"></script>
    <script src="/uptown/js/jquery.stellar.min.js"></script>
    <script src="/uptown/js/owl.carousel.min.js"></script>
    <script src="/uptown/js/jquery.magnific-popup.min.js"></script>
    <script src="/uptown/js/aos.js"></script>
    <script src="/uptown/js/jquery.animateNumber.min.js"></script>
    <script src="/uptown/js/bootstrap-datepicker.js"></script>
    <script src="/uptown/js/jquery.timepicker.min.js"></script>
    <script src="/uptown/js/scrollax.min.js"></script>
    <script src="/uptown/js/google-map.js"></script>
    <script src="/uptown/js/main.js?v=counter-scroll-trigger"></script>
  </body>
</html>
