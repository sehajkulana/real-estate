<% content_for :title, "Create Account | DUA Real Estate" %>

<div class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8 glass-card rounded-3xl p-8 md:p-10 border border-gold-500/30 shadow-2xl shadow-black/80">
    <div class="text-center">
      <span class="font-serif text-3xl md:text-4xl font-bold text-gold-500 tracking-widest block mb-1">DUA</span>
      <h2 class="text-2xl font-serif font-bold text-white tracking-tight">Create Your Account</h2>
      <p class="mt-2 text-xs text-gray-400">Join DUA Real Estate to explore luxury listings</p>
    </div>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :first_name, "First Name", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2" %>
          <%= f.text_field :first_name, autofocus: true, placeholder: "John", class: "w-full rounded-xl border border-white/10 bg-obsidian-950/80 px-4 py-3 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-gold-500/60 focus:ring-1 focus:ring-gold-500/60 transition-all" %>
        </div>
        <div>
          <%= f.label :last_name, "Last Name", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2" %>
          <%= f.text_field :last_name, placeholder: "Doe", class: "w-full rounded-xl border border-white/10 bg-obsidian-950/80 px-4 py-3 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-gold-500/60 focus:ring-1 focus:ring-gold-500/60 transition-all" %>
        </div>
      </div>

      <div>
        <%= f.label :email, "Email Address", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2" %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gold-500/70">
            <i class="fa-solid fa-envelope text-sm"></i>
          </div>
          <%= f.email_field :email, autocomplete: "email", required: true, placeholder: "you@example.com", class: "w-full rounded-xl border border-white/10 bg-obsidian-950/80 pl-11 pr-4 py-3 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-gold-500/60 focus:ring-1 focus:ring-gold-500/60 transition-all" %>
        </div>
      </div>

      <div>
        <%= f.label :password, "Password", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2" %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gold-500/70">
            <i class="fa-solid fa-lock text-sm"></i>
          </div>
          <%= f.password_field :password, autocomplete: "new-password", required: true, placeholder: "••••••••", class: "w-full rounded-xl border border-white/10 bg-obsidian-950/80 pl-11 pr-4 py-3 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-gold-500/60 focus:ring-1 focus:ring-gold-500/60 transition-all" %>
        </div>
        <% if @minimum_password_length %>
          <p class="text-[10px] text-gray-500 mt-1">(<%= @minimum_password_length %> characters minimum)</p>
        <% end %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm Password", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2" %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gold-500/70">
            <i class="fa-solid fa-shield-halved text-sm"></i>
          </div>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, placeholder: "••••••••", class: "w-full rounded-xl border border-white/10 bg-obsidian-950/80 pl-11 pr-4 py-3 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-gold-500/60 focus:ring-1 focus:ring-gold-500/60 transition-all" %>
        </div>
      </div>

      <div>
        <%= f.submit "Create Account", class: "w-full bg-gold-500 hover:bg-gold-400 text-obsidian-950 font-bold uppercase tracking-widest text-xs py-3.5 px-4 rounded-xl transition-all shadow-lg shadow-gold-500/20 cursor-pointer" %>
      </div>
    <% end %>

    <div class="pt-4 border-t border-white/5 text-center">
      <p class="text-xs text-gray-400">
        Already have an account?
        <%= link_to "Log In", new_session_path(resource_name), class: "text-gold-400 hover:text-gold-300 font-semibold transition-colors ml-1" %>
      </p>
    </div>
  </div>
</div>
