<% content_for :title, "Log In | DUA Real Estate" %>

<div class="min-h-[75vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8 glass-card rounded-3xl p-8 md:p-10 border border-gold-500/30 shadow-2xl shadow-black/80">
    <div class="text-center">
      <span class="font-serif text-3xl md:text-4xl font-bold text-gold-500 tracking-widest block mb-1">DUA</span>
      <h2 class="text-2xl font-serif font-bold text-white tracking-tight">Welcome Back</h2>
      <p class="mt-2 text-xs text-gray-400">Sign in to access your luxury real estate account</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6", data: { turbo: false } }) do |f| %>
      <div class="space-y-4">
        <div>
          <%= f.label :email, "Email Address", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2" %>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gold-500/70">
              <i class="fa-solid fa-envelope text-sm"></i>
            </div>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, placeholder: "you@example.com", class: "w-full rounded-xl border border-white/10 bg-obsidian-950/80 pl-11 pr-4 py-3 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-gold-500/60 focus:ring-1 focus:ring-gold-500/60 transition-all" %>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <%= f.label :password, "Password", class: "block text-xs font-semibold text-gray-300 uppercase tracking-wider" %>
            <%- if devise_mapping.recoverable? %>
              <%= link_to "Forgot Password?", new_password_path(resource_name), class: "text-xs text-gold-400 hover:text-gold-300 transition-colors" %>
            <% end %>
          </div>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gold-500/70">
              <i class="fa-solid fa-lock text-sm"></i>
            </div>
            <%= f.password_field :password, autocomplete: "current-password", required: true, placeholder: "••••••••", class: "w-full rounded-xl border border-white/10 bg-obsidian-950/80 pl-11 pr-4 py-3 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-gold-500/60 focus:ring-1 focus:ring-gold-500/60 transition-all" %>
          </div>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center justify-between pt-1">
            <label class="flex items-center space-x-2 cursor-pointer">
              <%= f.check_box :remember_me, class: "w-4 h-4 rounded bg-obsidian-950 border-white/10 accent-gold-500 cursor-pointer" %>
              <span class="text-xs text-gray-400 font-medium">Remember me on this device</span>
            </label>
          </div>
        <% end %>
      </div>

      <div>
        <%= f.submit "Log In", class: "w-full bg-gold-500 hover:bg-gold-400 text-obsidian-950 font-bold uppercase tracking-widest text-xs py-3.5 px-4 rounded-xl transition-all shadow-lg shadow-gold-500/20 cursor-pointer" %>
      </div>
    <% end %>

    <div class="pt-4 border-t border-white/5 text-center">
      <p class="text-xs text-gray-400">
        Don't have an account yet?
        <%= link_to "Create Account", new_registration_path(resource_name), class: "text-gold-400 hover:text-gold-300 font-semibold transition-colors ml-1" %>
      </p>
    </div>
  </div>
</div>
